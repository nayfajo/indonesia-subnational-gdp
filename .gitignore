# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Raw source PDFs (large; keep separately)
raw/

# Intermediate pipeline outputs (regenerable from scripts + crosswalks),
# EXCEPT the 21 parsed stage-1 CSVs — the paid vision-API parse output and the
# reproducibility anchor, which are tracked.
pipeline_out/*
!pipeline_out/full_runs/
pipeline_out/full_runs/*
!pipeline_out/full_runs/csvs/
harmonized/
standardized/

# Replication package (generated by scripts/make_package.py)
replication/

# Root-level archive of superseded audit files and old DAPOER extracts
archive/

# Claude Code local settings
.claude/

# Generated Word exports (regenerate from the .md with pandoc; markdown is canonical)
docs/*.docx

# Word lock/temp files
~$*

# Git worktree used for rename-csvs experiment
rename-test/

# macOS
.DS_Store
